# ============================================================
# LiteGameNext — Unity 2022.3.55f1c1
# 原则：只入库"工程事实"——Assets 下的源码/资源、ProjectSettings、Packages 清单、Docs、Tools、Tests。
#       生成物、本机产物、第三方原件一律不入库（缺了什么用清单还原，见 Docs/设计文档/02 §5）。
# ============================================================

# ----- Unity 生成目录 -----
[Ll]ibrary/
[Tt]emp/
[Oo]bj/
[Bb]in/
[Bb]uild/
[Bb]uilds/
[Ll]ogs/
[Uu]serSettings/
[Mm]emoryCaptures/
[Rr]ecordings/
CrashDumps/
*.stackdump

# ----- 工程产物 / 本机目录 -----
Bundles/
Dist/
Outbox/
TestResults/
HybridCLRData/
LocalCDN/
LocalNotes/
.dsh-artifacts/
*.unitypackage

# ----- 第三方原件（不入库；按 02 §5 清单还原）-----
Assets/ThirdParty/
Assets/Plugins/

# ----- 开发工具：Unity Pipeline（Unity 官方包 + 旧仓 2022.3 兼容补丁，13.4 MB；版权件不入库）-----
# 新克隆/换机：python Tools/restore_pipeline.py
Packages/com.unity.pipeline/

# ----- IDE / 编辑器 -----
.vs/
.idea/
.vscode/
*.suo
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.opendb
*.VC.db
.gradle/

# Unity 自动生成的工程文件不入库；手写的 xUnit 工程例外（02 §6.3）
*.csproj
*.sln
!Tests/LiteGame.Tests.csproj

# ----- dotnet 构建输出 -----
.dotnet/
.dotnet-cli/
Tests/**/bin/
Tests/**/obj/

# ----- Python -----
__pycache__/
*.pyc
.venv/

# ----- 系统 / 临时 -----
.DS_Store
Thumbs.db
desktop.ini
*.tmp
*.log
